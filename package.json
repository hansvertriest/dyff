{
  "name": "@hansvertriest/dyff",
  "version": "0.1.1",
  "description": "Index a NestJS codebase into a symbol/reference graph and overlay pull requests on it: changed symbols, broken callers, affected routes, module cycles and test reach.",
  "keywords": [
    "nestjs",
    "pull-request",
    "code-review",
    "ts-morph",
    "call-graph",
    "dependency-graph"
  ],
  "license": "MIT",
  "author": "Hans Vertriest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hansvertriest/dyff.git"
  },
  "homepage": "https://github.com/hansvertriest/dyff#readme",
  "bugs": {
    "url": "https://github.com/hansvertriest/dyff/issues"
  },
  "type": "module",
  "bin": {
    "dyff": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "viewer",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  }
}
